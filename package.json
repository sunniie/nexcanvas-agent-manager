{
  "name": "nexcanvas-agent-manager",
  "version": "0.1.0",
  "description": "A local pixel-art office where a lead agent hires, delegates to, and reviews a team of Claude Code and Codex agents.",
  "license": "MIT",
  "author": "Le Quang Vinh",
  "homepage": "https://github.com/sunniie/nexcanvas-agent-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunniie/nexcanvas-agent-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sunniie/nexcanvas-agent-manager/issues"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "claude-code",
    "codex",
    "agent-orchestration",
    "pixel-art",
    "developer-tools",
    "git-worktree"
  ],
  "type": "module",
  "bin": {
    "nexcanvas": "bin/nexcanvas.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && node --import tsx server/index.ts --open",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
